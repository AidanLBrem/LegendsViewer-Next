<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<SpaRoot>$(MSBuildThisFileDirectory)legends-viewer-frontend\</SpaRoot>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
		<EnableDefaultContentItems>false</EnableDefaultContentItems>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageJson Include="$(SpaRoot)package.json" />
		<SourceFiles Include="$(SpaRoot)**\*" Exclude="$(SpaRoot)node_modules\**\*;$(SpaRoot)dist\**\*" />
	</ItemGroup>

	<!--
	  The Vite build creates content-hashed filenames on EVERY change.
	  Register Content only after npm has finished creating dist. Static
	  globs (or BeforeBuild-only globs) can capture yesterday's filenames
	  and leave the backend's output with missing JS/CSS chunks.
	  AssignTargetPaths is used by MSBuild's transitive project-reference
	  content-copy pipeline, so it must see the newly generated assets.
	-->
	<Target Name="BuildSpaAndIncludeAssets" BeforeTargets="AssignTargetPaths">
		<Message Importance="high" Text="Installing frontend dependencies..." />
		<Exec Command="npm install" WorkingDirectory="$(SpaRoot)" />
		<Message Importance="high" Text="Building frontend and registering generated assets..." />
		<Exec Command="npm run build" WorkingDirectory="$(SpaRoot)" />
		<ItemGroup>
			<Content Include="$(SpaRoot)dist\**\*">
				<Link>legends-viewer-frontend\dist\%(RecursiveDir)%(Filename)%(Extension)</Link>
				<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			</Content>
		</ItemGroup>
	</Target>

</Project>
